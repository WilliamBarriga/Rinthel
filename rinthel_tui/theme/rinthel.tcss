/* rinthel.tcss — el archivo que se edita el 95% de las veces.
   Bordes, colores por widget, espaciado. Reemplaza a nc_divider/nc_banner/
   nc_footer/nc_panel/nc_rule (cajas ASCII dibujadas a mano con printf). */

Screen {
    background: $background;
    color: $primary;
}

SplashScreen, FarewellScreen, MenuScreen {
    align: center middle;
}

.nc-panel {
    border: round $primary;
    color: $accent;
    padding: 0 2;
}

.nc-dim {
    color: $dim;
    margin-top: 1;
}

.nc-warn {
    color: $warning;
}

.nc-success {
    color: $success;
}

.nc-hot {
    color: $error;
}

.nc-caution {
    color: $caution;
}

.swatch {
    width: 10;
    content-align: center middle;
}

/* ── Menú (caja centrada) ─────────────────────────────────── */

#menu-box {
    align: center middle;
    width: 60;
    height: auto;
    border: round $accent;
    padding: 1 2;
    margin: 2 0;
}

.menu-title {
    text-align: center;
    width: 100%;
    color: $accent;
    margin-bottom: 1;
}

#menu-options {
    border: none;
}

#menu-footer {
    height: 1;
    dock: bottom;
    color: $dim;
    margin-top: 1;
}

.tagline {
    text-align: center;
    width: 100%;
    color: $dim;
    margin-bottom: 1;
}

/* Separadores temáticos — opciones disabled del menú */
#menu-options .option-list--option-disabled {
    color: $dim;
}

/* Focus highlight — opción seleccionada (clase oficial Textual) */
#menu-options .option-list--option-highlighted {
    background: $accent;
    color: $background;
    text-style: bold;
}

/* Hover — opción con mouse encima (clase oficial Textual) */
#menu-options .option-list--option-hover {
    background: $electric-dim;
    color: $primary;
}

.service-badge {
    width: auto;
    margin: 0 2;
}

.service-badge.-online {
    color: $success;
}

.service-badge.-offline {
    color: $error;
}

/* ── Splash ───────────────────────────────────────────────── */

.splash-title {
    color: $accent;
    text-align: center;
    width: 100%;
}

.splash-prompt {
    color: $dim;
    text-align: center;
    width: 100%;
}

/* ── Checklist de fases ───────────────────────────────────── */

PhaseChecklist {
    height: auto;
    padding: 1 2;
}

.phase-row {
    height: 1;
}

.phase-pending {
    color: $dim;
}

.phase-running {
    color: $primary;
}

.phase-done {
    color: $success;
}

.phase-warn {
    color: $caution;
}

.phase-error {
    color: $error;
}

/* ── Paneles con borde — vocabulario genérico reusado por cualquier
   screen vía classes="panel" + border_title (reemplaza el header manual
   Static(classes="nc-divider") que tenía cada screen antes) ─────────── */

.panel {
    border: round $primary;
    padding: 0 1;
    margin-top: 1;
}

#tail-log, #phase-log, #capture-log, #monitor-log {
    height: 1fr;
}

#monitor-docker {
    height: 8;
}

/* ── Efectos de texto (tui/effects/flicker.py) ───────────── */

.-reverse {
    background: $primary;
    color: $background;
}

/* ── Monitor ──────────────────────────────────────────────── */

#monitor-badges {
    height: 1;
    padding: 0 1;
}

#monitor-badges .service-badge {
    margin: 0 3 0 0;
}

#monitor-resources {
    height: 6;
}

.monitor-panel {
    width: 1fr;
}

/* ── Settings ([N] CONFIGURAR) ────────────────────────────── */

#settings-body {
    height: 1fr;
}

#settings-list {
    width: 40;
}

#settings-detail {
    width: 1fr;
}

.settings-row {
    height: 3;
}

.settings-row-btn {
    margin-left: 1;
}

.settings-field-label {
    color: $dim;
    margin-top: 1;
}

#settings-footer {
    height: 3;
    align: left middle;
}

#settings-footer Static {
    margin-left: 2;
}
