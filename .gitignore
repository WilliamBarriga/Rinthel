# Estado real de los managed services (bundle de Understory, portal.db/
# sessions de Pithagoras) — nunca dentro de understory/ ni pithagoras/ (esos
# son subtrees, pueden pushearse de vuelta al fork) para que un secret/dato
# real nunca termine en ese push.
data/

# graphify — generated knowledge graph, regenerable, not source
graphify-out/
graphify-vault/

# archify — generated diagram output, regenerable, not source
archify-demo/

# pi local state — ignore .pi/ except the graphify skill, which we want
# tracked so a future session has it ready without reinstalling
.pi/*
!.pi/agent/
.pi/agent/*
!.pi/agent/skills/
.pi/agent/skills/*
!.pi/agent/skills/graphify/

# wayfinder — local markdown issue tracker, not source
.scratch/

# news — curated Reddit/LLM roundups, regenerable from web searches
news/

# Playwright MCP — browser automation screenshots/session artifacts
.playwright-mcp/
.diagrams_venv/
