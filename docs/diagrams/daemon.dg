// Rinthel Daemon (FastAPI): one hexagonal module per folder of rinthel/rinthel_tui/<module>/{domain,adapters}.
// The domain owns each port; adapters (sqlite, httpx, filesystem, memory) sit behind it.
// Composition root: api/__init__.py:create_app builds one compose() per area (api/<area>/compose.py).
model {
  extend daemon {
    ruta api "API" "One package per area (api/<area>/: compose, routes, dtos); the access policy is declared per route" {
      source { path "rinthel/rinthel_tui/api" }
      proceso api-compose "create_app" "Single composition root: adapters from the config, shared state and one compose() per area in explicit order" {
        source { path "rinthel/rinthel_tui/api/__init__.py" }
      }
      modulo api-access "access / caller" "Access policies (public, service, service_as_user, user, admin) and any_of; service_or_admin guards /theme and /openapi.json" {
        source { path "rinthel/rinthel_tui/api/access.py" }
      }
      ruta api-lifecycle "lifecycle" "/boot, /terminate, /reload, /install (service policy)" {
        source { path "rinthel/rinthel_tui/api/lifecycle" }
      }
      ruta api-secrets "secrets" "/secrets/rotate and write-only secrets" {
        source { path "rinthel/rinthel_tui/api/secrets" }
      }
      ruta api-config "config" "/config and /theme (palette shared with Deck)" {
        source { path "rinthel/rinthel_tui/api/config" }
      }
      ruta api-ws "ws" "/ws/monitor: Telemetry streams and phase progress" {
        source { path "rinthel/rinthel_tui/api/ws" }
      }
      ruta api-identity "identity" "Login, refresh, users, /me/session-principal" {
        source { path "rinthel/rinthel_tui/api/identity" }
      }
      ruta api-models "models" "GET /model-provider/routing (service policy) and the active Local model switch" {
        source { path "rinthel/rinthel_tui/api/models" }
      }
    }

    modulo identity "identity" "Users (admin or miembro), refresh tokens, last-admin guard, Panel token issue and refresh" {
      source { path "rinthel/rinthel_tui/identity" }
      puerto id-puertos "ports" "Identity port; transaction() wraps multi-step use cases"
      adaptador id-sqlite "sqlite" "rinthel.db; connection per call, BEGIN IMMEDIATE on writes"
      adaptador id-memoria "memory" "Doubles of Identity and DeckSessions with a contract suite"
      puerto id-deck "DeckSessions" "One method: retire a user's Sessions before deleting the user; None while Deck is disabled"
      adaptador id-deck-http "deck_http" "httpx: POST /api/agent/retire-sessions with the service secret and X-Rinthel-User-Id"
      proceso id-admin "reset-admin" "First admin of INSTALL and the local reset-admin command"
    }

    modulo database "database" "rinthel.db: connection (rollback journal, foreign_keys, busy_timeout) and migrations by user_version at startup; fails if SQLite < 3.37 or the file is newer" {
      source { path "rinthel/rinthel_tui/database.py" }
    }

    modulo models "models" "Local models: catalog file, active model, route and switch" {
      source { path "rinthel/rinthel_tui/models" }
      modulo mod-catalogo "catalog" "models.local.json (hand-written, untracked) and the Validated profile of the Platform"
      proceso mod-cambio "switch" "kill, spawn, ready, rollback on failure, under the global lifecycle lock"
      modulo mod-ruta "routing" "URL, id, context window and reasoning format of the active model; the active id lives in instance.toml"
    }

    modulo lifecycle "lifecycle" "Lifecycle plans of the managed services" {
      source { path "rinthel/rinthel_tui/lifecycle" }
      proceso lc-planes "Lifecycle" "boot, terminate, reload, install: plans run as units of phases under a global lock" {
        source { path "rinthel/rinthel_tui/lifecycle/commands.py" }
      }
      modulo lc-specs "specs / executor" "Plans as batches of units of phases; the executor runs them and broadcasts progress" {
        source { path "rinthel/rinthel_tui/lifecycle/specs.py" }
      }
      modulo lc-fases "phases / services" "Phases and the catalog of managed services (local process or compose)" {
        source { path "rinthel/rinthel_tui/lifecycle/services.py" }
      }
      modulo lc-install "install" "Install: pinned models, compose services, first admin user" {
        source { path "rinthel/rinthel_tui/lifecycle/install.py" }
      }
      puerto host "Host" "Eight ports: Runner, Processes, Compose, Probe, Clock, HostInfo, PackageRegistry, DataDirs"
      adaptador host-procesos "processes" "Per Platform (POSIX, Windows)"
      adaptador host-compose "docker_compose"
      adaptador host-sondeo "probe / host_info / npm_registry"
    }

    modulo monitoring "monitoring" "Telemetry streams: host resources, managed services and the active model status" {
      source { path "rinthel/rinthel_tui/monitoring" }
      puerto mon-puertos "ports" "One port per source: GPU, host, containers, llama-server log, readiness"
      adaptador mon-host "psutil_host / nvidia_smi / docker_compose / log_file / http_readiness"
      adaptador mon-memoria "memory" "Doubles with a contract suite"
    }

    modulo nu-config "config / instance" "Configuration, .env and instance.toml; Instance root discovery; deck.host_address builds every URL given to Deck" {
      source { path "rinthel/rinthel_tui/config.py" }
    }
    modulo nu-theme "theme" "Palette shared with the TUI and Deck" {
      source { path "rinthel/rinthel_tui/theme" }
    }
  }

  // Edges inside the daemon
  daemon.api.api-compose -> daemon.api.api-access
  daemon.api.api-lifecycle -> daemon.lifecycle.lc-planes
  daemon.api.api-ws -> daemon.monitoring
  daemon.api.api-identity -> daemon.identity
  daemon.api.api-models -> daemon.models
  daemon.api.api-config -> daemon.nu-config
  daemon.api.api-config -> daemon.nu-theme
  daemon.models.mod-cambio -> daemon.lifecycle.lc-planes "restarts llama-server"
  daemon.models.mod-catalogo -> daemon.nu-config "active id from instance.toml"
  daemon.lifecycle.lc-planes -> daemon.lifecycle.lc-specs
  daemon.lifecycle.lc-specs -> daemon.lifecycle.lc-fases
  daemon.lifecycle.lc-install -> daemon.identity "first admin"
  daemon.lifecycle.lc-install -> daemon.database "migrate"
  daemon.identity.id-sqlite -> daemon.database "connection"
  daemon.lifecycle.lc-fases -> daemon.lifecycle.host
  daemon.lifecycle.host-procesos -> daemon.lifecycle.host
  daemon.lifecycle.host-compose -> daemon.lifecycle.host
  daemon.lifecycle.host-sondeo -> daemon.lifecycle.host
  daemon.monitoring.mon-host -> daemon.monitoring.mon-puertos
  daemon.monitoring.mon-memoria -> daemon.monitoring.mon-puertos
  daemon.identity.id-sqlite -> daemon.identity.id-puertos
  daemon.identity.id-memoria -> daemon.identity.id-puertos
  daemon.identity.id-deck-http -> daemon.identity.id-deck
  daemon.identity.id-admin -> daemon.identity.id-puertos
}
