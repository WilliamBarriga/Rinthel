# Copiar a `.env` en la raíz del repo y descomentar/ajustar lo que haga
# falta. Todo lo que quede comentado usa el default de
# rinthel_tui/config.py::default_config() — o sea, nada cambia si no tocás
# este archivo. `.env` está en .gitignore, no se sube al repo.

# ── LLAMA-SERVER (binario y modelo) ────────────────────────────
# RINTHEL_LLAMA_BIN=~/codacus/llama.cpp/build-cuda/bin/llama-server
# RINTHEL_LLAMA_MODEL_PATH=~/llama.cpp/models/Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf
# RINTHEL_LLAMA_PORT=8080
# RINTHEL_LLAMA_LOG_PATH=~/Rinthel-general/logs/llama-server.log
# Si es false, [0] INSTALL/[1] BOOT/[2] RELOAD/[3] TERMINATE dejan de tocar
# este servicio (no lo instalan, no lo bootean, no aparece su badge).
# RINTHEL_LLAMA_ENABLED=true

# ── LLAMA-SERVER (flags de inferencia) ─────────────────────────
# RINTHEL_NGL=all
# RINTHEL_CONTEXT_WINDOW=112000
# RINTHEL_FLASH_ATTENTION=true
# RINTHEL_FLASH_INFERENCE=false
# RINTHEL_N_CPU_MOE=60
# RINTHEL_THREADS_BATCH=7
# RINTHEL_THREADS=8
# RINTHEL_UBATCH_SIZE=512
# RINTHEL_BATCH_SIZE=512
# RINTHEL_PARALLEL=1
# RINTHEL_TEMPERATURE=0.7
# RINTHEL_TOP_P=0.8
# RINTHEL_TOP_K=20
# RINTHEL_MIN_P=0.1
# RINTHEL_REPEAT_PENALTY=1.05
# RINTHEL_CACHE_REUSE=256
# RINTHEL_CACHE_RAM=-1
# RINTHEL_LOAD_MODE=mlock
# RINTHEL_SPEC_TYPE=draft-mtp
# RINTHEL_SPEC_DRAFT_N_MAX=2

# ── WHISPER (STT, docker) ────────────────────────────────────────
# Binario/modelo/auth ya no van acá — quedan horneados en la imagen de
# services/whisper-stt/ (Dockerfile propio, sin binarios sueltos en el
# host). AUTH_TOKEN/ALLOWED_ORIGIN viven en services/whisper-stt/.env,
# generado por [0] INSTALL — no son parte de este .env ni de [7] CONFIGURAR.
# RINTHEL_WHISPER_DIR=~/Rinthel-general/services/whisper-stt
# RINTHEL_WHISPER_PORT=8090
# RINTHEL_WHISPER_ENABLED=true

# ── TTS (Piper, docker) ──────────────────────────────────────────
# Mismo criterio que WHISPER: binario/voces horneados en la imagen de
# services/tts-piper/. AUTH_TOKEN/ALLOWED_ORIGIN/MAX_TEXT_LENGTH viven en
# services/tts-piper/.env, generado por [0] INSTALL.
# RINTHEL_TTS_DIR=~/Rinthel-general/services/tts-piper
# RINTHEL_TTS_PORT=8091
# RINTHEL_TTS_ENABLED=true

# ── MOE TRACE ───────────────────────────────────────────────────
# RINTHEL_MOE_TRACE_BUILD=~/codacus/llama.cpp/build-cuda/bin/llama-moe-trace
# RINTHEL_MOE_TRACE_OUT_DIR=~/codacus/profiles
# RINTHEL_MOE_CACHE_PROFILE=~/codacus/profiles/qwen3.6-merged.csv

# ── UNDERSTORY (MCP memory layer) ──────────────────────────────
# RINTHEL_UNDERSTORY_DIR=~/understory-poc
# RINTHEL_UNDERSTORY_PORT=3800
# RINTHEL_UNDERSTORY_ENABLED=true

# ── PITHAGORAS (task portal) ───────────────────────────────────
# RINTHEL_PITHAGORAS_DIR=~/pithagoras
# RINTHEL_PITHAGORAS_PORT=4100
# RINTHEL_PITHAGORAS_ENABLED=true

# ── TUI ─────────────────────────────────────────────────────────
# Apaga efectos visuales (glow/glitch/ripple) — útil en CI o terminales lentos.
# RINTHEL_EFFECTS=true

# ── INSTALL (bootstrap de infra en máquina nueva, [0] INSTALL) ──
# RINTHEL_LLAMACPP_REPO_DIR=~/codacus/llama.cpp
# RINTHEL_LLAMACPP_REPO_URL=https://github.com/thecodacus/llama.cpp.git
# RINTHEL_MODEL_DOWNLOAD_URL=https://huggingface.co/unsloth/Qwen3.6-35B-A3B-MTP-GGUF/resolve/main/Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf
# RINTHEL_PITHAGORAS_REPO_URL=https://github.com/WilliamBarriga/pithagoras.git
# Carpeta que Pithagoras monta en /workspaces (WORKSPACES_DIR en su .env) —
# default $HOME.
# RINTHEL_WORKSPACES_DIR=~
