# Copy to `.env` at the repo root and uncomment/adjust whatever you need.
# Anything left commented out uses the default from
# rinthel_tui/config.py::default_config(). The lines already uncommented
# here (CACHE_TYPE_K/V, MOE_CACHE_MIB) carry the values production actually
# runs with — verified 2026-09-24 against the live process; the config.py
# defaults differ and don't survive a real request on this hardware (see
# each section's comment). Production also overrides SPEC_TYPE,
# UBATCH/BATCH (2048), N_CPU_MOE (99), CACHE_REUSE (256) and the llama.cpp
# paths — shown commented below with their production value.
# `.env` is in .gitignore, never committed to the repo.
#
# The model itself is not here: each Local model (GGUF, mmproj, MTP, context
# window, reasoning format) is an entry of models.local.json at the Instance
# root, edited by hand; the active one is chosen with
# `python -m rinthel_tui.models use <id>` (services stopped) or from the
# daemon. Production's context window (131072) goes in its catalog entry.
# RINTHEL_LLAMA_MODEL_PATH, RINTHEL_CONTEXT_WINDOW, RINTHEL_LLAMA_MMPROJ_*
# and RINTHEL_MTP_ENABLED are ignored with a warning.

# ── LLAMA-SERVER (binary) ──────────────────────────────────────
# RINTHEL_LLAMA_BIN=~/llama.cpp/src/build-cuda/bin/llama-server
# RINTHEL_LLAMA_PORT=8080
# RINTHEL_LLAMA_LOG_PATH=~/Rinthel-general/logs/llama-server.log
# If false, [0] INSTALL/[1] BOOT/[2] RELOAD/[3] TERMINATE stop touching
# this service (won't install it, won't boot it, its badge won't show up).
# RINTHEL_LLAMA_ENABLED=true

# ── LLAMA-SERVER (inference flags) ─────────────────────────
# RINTHEL_NGL=all
#
# The uncommented values below deliberately differ from the hardcoded
# defaults in config.py — the default batch 512 leaves a large part of the
# prefill throughput on the table. The values here are the config verified
# in production against 8 GB of VRAM (2026-09-24). Why each one is set this
# way: see docs/02-hardware-optimization.md.
# RINTHEL_FLASH_ATTENTION=true
# RINTHEL_FIT_TO_MEMORY=false
# Production value: 99 = every MoE layer served from RAM, with the expert
# cache keeping the hot experts resident in VRAM (config.py default 60).
# RINTHEL_N_CPU_MOE=99
# RINTHEL_THREADS_BATCH=7
# RINTHEL_THREADS=8
# Production value: 2048 — the largest batch that still clears the
# ~300 MiB free-VRAM floor with the rest of this config (3072 crosses it).
# RINTHEL_UBATCH_SIZE=2048
# RINTHEL_BATCH_SIZE=2048
# RINTHEL_PARALLEL=1
# RINTHEL_TEMPERATURE=0.7
# RINTHEL_TOP_P=0.8
# RINTHEL_TOP_K=20
# RINTHEL_MIN_P=0.1
# RINTHEL_REPEAT_PENALTY=1.05
# No-op with this hybrid context (kv_unified=false): the server logs
# "cache_reuse is not supported by this context, it will be disabled" at
# every boot. Harmless, but it is NOT doing anything — don't count it as
# an active optimization. Production value shown.
# RINTHEL_CACHE_REUSE=256
# RINTHEL_CACHE_RAM=-1
# RINTHEL_LOAD_MODE=mlock
# ── MTP (multi-token prediction, speculative decoding) ─────────────────
# Each Local model turns it on/off ("mtp" in its catalog entry): false =
# --spec-type none, true = --spec-type RINTHEL_SPEC_TYPE below. Costs
# ~650 MiB of VRAM for its compute buffer: on this 8 GB
# card, MTP + batch/ubatch 2048 reproduced a real CUDA OOM (48 MiB free,
# test-tarkAIrk/logs/27) — if the server dies on the first real request,
# drop RINTHEL_UBATCH_SIZE/RINTHEL_BATCH_SIZE to 1024 or 512 (512 is the
# minimum-VRAM candidate with MTP: KV q8_0 leaves 1270-1370 MiB free
# there, test-tarkAIrk/handoff/04) or turn MTP off again. MTP also does
# not support --parallel > 1 nor --mmproj (the latter is simply omitted
# from the command while MTP is on). Details:
# docs/02-hardware-optimization.md.
# Current state: OFF since 2026-09-24 (Tarkark's call — ~650 MiB-1 GB of
# VRAM for ~+6-7 gen_tps doesn't fit next to batch 2048).
# Mode used while the model turns MTP on — draft-mtp is what the MTP-aware
# gguf (unsloth/Qwen3.6-35B-A3B-MTP-GGUF) expects.
# RINTHEL_SPEC_TYPE=draft-mtp
# Draft depth per speculative round (higher = faster generation, more VRAM).
# RINTHEL_SPEC_DRAFT_N_MAX=2
# KV cache quantization (default f16 if left commented out). q8_0/q8_0
# roughly halves KV cache size — validated in production (agent-bench
# round, no quality/loop regression, min free VRAM 121-308 MiB → 1270-1370
# MiB under real load), see test-tarkAIrk/logs/22-2026-09-15-kv-cache-quant-q8-validacion-agentica.md.
# Always quantize both k and v together — one without the other silently
# overflows to shared PCIe memory, see test-tarkAIrk/handoff/01-gotchas.md.
RINTHEL_CACHE_TYPE_K=q8_0
RINTHEL_CACHE_TYPE_V=q8_0

# ── MOE EXPERT CACHE ────────────────────────────────────────────
# MiB of VRAM used to cache the MoE experts that live on the CPU
# (--moe-cache-mib in upstream llama.cpp). 0 = disabled (default). Only
# added to the command if > 0 (see rinthel_tui/lifecycle/services.py).
# Spends VRAM that the KV cache / batch buffers need: raise it in steps and
# watch free VRAM under real load. Details: docs/02-hardware-optimization.md.
RINTHEL_MOE_CACHE_MIB=0

# ── VOICE (opt-in, Linux only) ─────────────────────────────────
# whisper-server (stt, CPU) and audiocpp-server (tts, CUDA), both on
# loopback. They run while instance.toml has an active `stt`/`tts`; the
# model and the fixed voice are catalog entries, not variables here.
# `python -m rinthel_tui.install --voice` builds, downloads and activates
# them. See docs/local-models.md.
# RINTHEL_WHISPER_BIN=~/whisper.cpp/build/bin/whisper-server
# RINTHEL_WHISPER_PORT=8178
# RINTHEL_WHISPER_LOG_PATH=~/Rinthel-general/logs/whisper-server.log
# RINTHEL_WHISPER_THREADS=4
# RINTHEL_AUDIOCPP_BIN=~/audio.cpp/build/rinthel/bin/audiocpp_server
# RINTHEL_AUDIOCPP_PORT=7860
# RINTHEL_AUDIOCPP_LOG_PATH=~/Rinthel-general/logs/audiocpp-server.log
# RINTHEL_AUDIOCPP_THREADS=4

# ── UNDERSTORY (MCP memory layer) ──────────────────────────────
# Default: <repo>/understory (subtree, Fase 1 del monorepo) — ya no
# ~/understory-poc. Estado real (bundle) vive en <repo>/data/understory,
# fuera del subtree; ver docker-compose.yaml de la raíz.
# RINTHEL_UNDERSTORY_DIR=~/Rinthel-general/understory
# RINTHEL_UNDERSTORY_PORT=3800
# RINTHEL_UNDERSTORY_ENABLED=true

# ── DECK (portal web) ──────────────────────────────────────────
# Default: <repo>/deck. Estado real (deck.db, home de pi) vive en
# <repo>/data/deck. Lee RINTHEL_PANEL_SECRET y RINTHEL_SERVICE_SECRET de
# este mismo .env.
# RINTHEL_DECK_DIR=~/Rinthel-general/deck
# RINTHEL_DECK_PORT=4100
# RINTHEL_DECK_ENABLED=true
# DECK_DB_JOURNAL_MODE=wal       # delete en Windows (bind mount)

# ── CONTAINERS: env de docker-compose ──────────────────────────
# Estos NO son RINTHEL_* (no los lee rinthel_tui/config.py) — los lee
# docker-compose.yaml directo, con un solo .env en la raíz.
# INSTALL escribe PUID/PGID (tu usuario, con el que corre Deck) y
# DOCKER_GID (el grupo docker del host) en Linux si faltan.
# PUID=
# PGID=
# DOCKER_GID=
# INSTALL genera el token de Understory, una sola fuente: el compose raíz se
# lo pasa a Understory como su AUTH_TOKEN (vacío o sin setear, compose falla)
# y Deck lo presenta para la Memoria de las Sesiones de admin.
# UNDERSTORY_TOKEN=
# TS_AUTHKEY=                    # solo si usás el perfil "vpn" de tailscale
#
# El fork de understory exige un LLM configurado para bootear (a diferencia
# de la imagen upstream vieja) — sin esto el contenedor crashea en loop con
# "No LLM configured". Mínimo funcional: apuntar al llama-server local vía
# host.docker.internal (ver extra_hosts en understory/docker-compose.yml).
# Stopgap de boot, no wiring real de Model provider (eso es Fase 4).
# LLM_API_BASE_URL=http://host.docker.internal:8080/v1
# LLM_API_KEY=local-no-auth
# LLM_API_FORMAT=openai
# LLM_MODEL=Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf
#
# OPENROUTER_API_KEY NO se le pasa a understory a propósito (ver comentario
# en understory/docker-compose.yml) — usar UNDERSTORY_OPENROUTER_API_KEY si
# understory necesita su propio OpenRouter más adelante.
# UNDERSTORY_OPENROUTER_API_KEY=

# ── DECK: how it reaches the host ─────────────────────────────
# How a container reaches the host: the daemon builds every URL it hands
# out with it (llama-server route, voice, hostexecd). Default per Platform:
# 127.0.0.1 on Linux (host network), host.docker.internal on Windows.
# RINTHEL_DECK_HOST_ADDRESS=127.0.0.1

# ── TUI ─────────────────────────────────────────────────────────
# Disables visual effects (glow/glitch/ripple) — useful in CI or slow terminals.
# RINTHEL_EFFECTS=true

# ── DAEMON (rinthel-daemon, proceso propio — no un servicio gestionado) ──
# Puerto donde escucha el daemon FastAPI. `rinthel-boot.sh` lo lee de acá
# para chequear si ya está arriba antes de autostartearlo, y para pasárselo
# al binario del cliente (`--port`).
# RINTHEL_DAEMON_PORT=8765
#
# Secretos de la Instance. INSTALL los genera (y `rinthel-boot.sh` genera el
# de servicio si falta); se rotan desde la TUI. Nunca salen por GET /config.
# RINTHEL_SERVICE_SECRET: la TUI lo manda en cada request
# (X-Rinthel-Service-Secret); vacío = el daemon no deja pasar a nadie.
# RINTHEL_PANEL_SECRET: firma los Panel tokens.
# RINTHEL_SERVICE_SECRET=
# RINTHEL_PANEL_SECRET=

# Vida del Panel token, en segundos: access (JWT, 1 día) y refresh (rota en
# cada uso, 30 días). Rotar RINTHEL_PANEL_SECRET invalida todos los access.
# RINTHEL_IDENTITY_ACCESS_TTL=86400
# RINTHEL_IDENTITY_REFRESH_TTL=2592000

# ── HOST EXEC (hostexecd, Linux only) ─────────────────────────
# A managed service of the daemon: BOOT starts it, TERMINATE stops it, the
# Monitor shows it. It runs an admin's commands on the host for Deck.
# RINTHEL_HOSTEXECD_PORT=8766
# RINTHEL_HOSTEXECD_ENABLED=true
# Shared by hostexecd and Deck; the daemon hands it to both. INSTALL writes it
# once and keeps it. Without it, hostexecd authenticates nobody and Deck loads
# no host exec tools.
# RINTHEL_HOSTEXECD_TOKEN=

# ── INSTALL (infra bootstrap on a new machine, [0] INSTALL) ──
# RINTHEL_LLAMACPP_REPO_DIR=~/llama.cpp/src
# RINTHEL_LLAMACPP_REPO_URL=https://github.com/ggml-org/llama.cpp.git
# Where INSTALL downloads the GGUF of the default Local model of the
# Validated profile (outside the repo); the catalog entry points there.
# RINTHEL_MODELS_DIR=~/llama.cpp/models
