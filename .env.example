# Required — the portal can run arbitrary commands, so lock it down.
PORTAL_PASSWORD=change-me
# Keeps sessions valid across restarts: openssl rand -hex 32
PORTAL_SECRET=

# Where your workspaces live on the host
WORKSPACES_DIR=/root/repos

# host = pi runs inside the portal container (fast, full access to mounted repos)
# container = one isolated container per task (needs the docker socket mount)
EXECUTOR=host

PI_PROVIDER=openrouter
PI_MODEL=anthropic/claude-sonnet-5
OPENROUTER_API_KEY=

# A local llama.cpp server, if you run one. Reachable from inside the container
# at the same address as on the host, because the container shares its network.
LLAMA_BASE_URL=http://127.0.0.1:8080

# STT (whisper.cpp) and TTS (Piper wrapper), both local processes orchestrated
# by Rinthel-general — same "reachable via host network" story as LLAMA_BASE_URL.
WHISPER_BASE_URL=http://127.0.0.1:8090
TTS_BASE_URL=http://127.0.0.1:8091

# Bearer token for understory's /mcp — same value goes into understory's own
# AUTH_TOKEN. Generate with: openssl rand -hex 24
UNDERSTORY_TOKEN=

# The agent's browser is installed from the portal (Browser → Install), not from
# here — it needs no configuration in this file.

# ── Portability overrides (usually left unset) ─────────────────────────────
# Only needed if your uid/gid isn't 1000:1000, or the "docker" group on your
# host isn't GID 984, or ~/.pi/agent lives somewhere other than $HOME/.pi/agent.
# PUID=1000
# PGID=1000
# DOCKER_GID=984
# PI_AGENT_DIR=/home/youruser/.pi/agent

# Set TS_AUTHKEY here only if you want the optional Tailscale sidecar
# (docker compose --profile vpn up -d). Left unset, it's skipped entirely.
# TS_AUTHKEY=
